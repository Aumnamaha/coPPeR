__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Data, Checkpoints, Exports (large binary artifacts)
data/
checkpoints/
exports/

# Local workspace notes / user artifacts (never committed)
workspace_notes/

# Model weight formats
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.mlmodel

# Environment / secrets
.env
.env.*
!.env.example

# Logs and temp files
*.log
*.tmp
*.temp

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Docker (local-only, no images committed)
.docker/

# Jupyter notebooks (temporary work)
*.ipynb
.ipynb_checkpoints/

# Windows PowerShell history
PSHistory.txt
